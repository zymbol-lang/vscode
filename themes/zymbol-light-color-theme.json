  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#aaaaaa", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#a0522d" }
    },
    {
      "name": "String interpolation / escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#008a48" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#1a6a99" }
    },
    {
      "name": "Booleans",
      "scope": ["constant.language.boolean"],
      "settings": { "foreground": "#1a6a99" }
    },
    {
      "name": "Keywords — control flow (? @ ?? _ <~ <# #>)",
      "scope": [
        "keyword.control",
        "keyword.operator.return-output",
        "keyword.control.import",
        "keyword.control.module",
        "keyword.operator.output",
        "keyword.operator.input",
        "constant.character.escape.newline",
        "storage.type.function.arrow"
      ],
      "settings": { "foreground": "#008a48", "fontStyle": "bold" }
    },
    {
      "name": "Operators — arithmetic, comparison, range, pipe, assignment",
      "scope": [
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.range",
        "keyword.operator.pipe",
        "keyword.operator.assignment",
        "keyword.operator.member-access",
        "keyword.operator.namespace",
        "keyword.operator.metadata",
        "keyword.operator.numeric-eval",
        "keyword.operator.format",
        "keyword.operator.base-conversion"
      ],
      "settings": { "foreground": "#3a6fa8" }
    },
    {
      "name": "Collection operators ($# $+ $- $~ $? $[)",
      "scope": ["keyword.operator.collection"],
      "settings": { "foreground": "#3a6fa8" }
    },
    {
      "name": "Hot-definition marker °",
      "scope": ["keyword.operator.hot-definition"],
      "settings": { "foreground": "#c05800", "fontStyle": "bold" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": { "foreground": "#888888" }
    },
    {
      "name": "Function names (definition & call)",
      "scope": ["entity.name.function"],
      "settings": { "foreground": "#7c3aed" }
    },
    {
      "name": "Variables / identifiers",
      "scope": ["variable.other"],
      "settings": { "foreground": "#333333" }
    },
    {
      "name": "Error tokens",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#cc2222" }
    }
  ]
}
