{
  "If Statement": {
    "prefix": "if",
    "body": [
      "? ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If conditional statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "? ${1:condition} {",
      "\t${2:// true branch}",
      "}",
      "_{",
      "\t${3:// false branch}",
      "}"
    ],
    "description": "If-else statement"
  },
  "If-ElseIf-Else Statement": {
    "prefix": "ifelif",
    "body": [
      "? ${1:condition1} {",
      "\t${2:// first branch}",
      "}",
      "_? ${3:condition2} {",
      "\t${4:// second branch}",
      "}",
      "_{",
      "\t${5:// else branch}",
      "}"
    ],
    "description": "If-elseif-else statement"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "result = ?? ${1:value} {",
      "\t${2:pattern1} => ${3:value1}",
      "\t${4:pattern2} => ${5:value2}",
      "\t_ => ${6:default}",
      "}"
    ],
    "description": "Pattern matching statement"
  },
  "For-Each Loop": {
    "prefix": "for",
    "body": [
      "@ ${1:item}:${2:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "For-each loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "@ ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Infinite Loop": {
    "prefix": "loop",
    "body": [
      "@ {",
      "\t$0",
      "}"
    ],
    "description": "Infinite loop"
  },
  "Range Loop": {
    "prefix": "range",
    "body": [
      "@ ${1:i}:${2:start}..${3:end} {",
      "\t$0",
      "}"
    ],
    "description": "Range loop"
  },
  "Lambda Function": {
    "prefix": "lambda",
    "body": [
      "${1:name} = ${2:param} -> ${3:expr}"
    ],
    "description": "Lambda function (simple)"
  },
  "Lambda Block": {
    "prefix": "lambdablock",
    "body": [
      "${1:name} = ${2:param} -> {",
      "\t${3:// body}",
      "\t<~ ${4:result}",
      "}"
    ],
    "description": "Lambda function (block)"
  },
  "Traditional Function": {
    "prefix": "func",
    "body": [
      "${1:name}(${2:params}) {",
      "\t${3:// body}",
      "\t<~ ${4:result}",
      "}"
    ],
    "description": "Traditional function"
  },
  "Output": {
    "prefix": "out",
    "body": [
      ">> ${1:value} ¶"
    ],
    "description": "Output with newline"
  },
  "Input": {
    "prefix": "in",
    "body": [
      "<< \"${1:prompt}: \" ${2:variable}"
    ],
    "description": "Input with prompt"
  },
  "Sleep": {
    "prefix": "sleep",
    "body": [
      "@~ ${1:milliseconds}"
    ],
    "description": "Sleep N milliseconds (@~ N)"
  },
  "Clear Screen": {
    "prefix": "cls",
    "body": [
      ">>!"
    ],
    "description": "Clear terminal screen (>>!)"
  },
  "Terminal Size": {
    "prefix": "termsize",
    "body": [
      "[${1:rows}, ${2:cols}] = >>?"
    ],
    "description": "Query terminal size — returns (rows, cols) tuple (>>?)"
  },
  "Key Input Blocking": {
    "prefix": "key",
    "body": [
      "<<| ${1:key_var}"
    ],
    "description": "Read one keypress — blocking (<<| var)"
  },
  "Key Input Non-Blocking": {
    "prefix": "keynb",
    "body": [
      "<<|? ${1:key_var}"
    ],
    "description": "Poll one keypress — non-blocking, '\\0' if none (<<|? var)"
  },
  "Positioned Output": {
    "prefix": "outp",
    "body": [
      ">>~ (${1:row}, ${2:col}) > ${3:value}"
    ],
    "description": "Print at terminal position (>>~ (row, col) > items)"
  },
  "Positioned Output with Style": {
    "prefix": "outps",
    "body": [
      ">>~ (${1:row}, ${2:col}, ${3:0}, ${4:fg}, ${5:bg}) > ${6:value}"
    ],
    "description": "Print at position with BKS style and ANSI colors (>>~ (row, col, BKS, fg, bg) > items). BKS: 1=Bold 2=Italic 4=Underline"
  },
  "Positioned Output Color Only": {
    "prefix": "outpc",
    "body": [
      ">>~ (,,, ${1:fg}) > ${2:value}"
    ],
    "description": "Set foreground color without moving cursor (>>~ (,,,fg) > items)"
  },
  "TUI Block": {
    "prefix": "tui",
    "body": [
      ">>| {",
      "\t${1:// terminal UI code}",
      "}"
    ],
    "description": "TUI block — alternate screen + raw mode (>>| { })"
  },
  "String Repeat": {
    "prefix": "repeat",
    "body": [
      "\"${1:str}\" $* ${2:n}"
    ],
    "description": "Repeat string N times ($* operator)"
  },
  "Hot Definition Accumulator (postfix)": {
    "prefix": "hotacc",
    "body": [
      "${1:total}° += ${2:value}"
    ],
    "description": "Hot definition postfix: variable anchors at nearest loop, dies when loop ends (x°)"
  },
  "Hot Definition Accumulator (prefix)": {
    "prefix": "hotpre",
    "body": [
      "°${1:total} += ${2:value}"
    ],
    "description": "Hot definition prefix: variable anchors above nearest loop, survives loop end (°x)"
  },
  "Named Tuple": {
    "prefix": "ntuple",
    "body": [
      "(${1:field1}: ${2:value1}, ${3:field2}: ${4:value2})"
    ],
    "description": "Named tuple"
  },
  "Array": {
    "prefix": "arr",
    "body": [
      "[${1:item1}, ${2:item2}, ${3:item3}]"
    ],
    "description": "Array literal"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "<# ${1:./module_path} => ${2:alias}"
    ],
    "description": "Import a module (alias is mandatory)"
  },
  "Import Module with Alias": {
    "prefix": "importalias",
    "body": [
      "<# ${1:module_path} => ${2:alias}"
    ],
    "description": "Import module with alias"
  },
  "Type Metadata": {
    "prefix": "meta",
    "body": [
      "info = ${1:value}#?",
      "type_symbol = info[1]"
    ],
    "description": "Get type metadata"
  },
  "Numeric Evaluation": {
    "prefix": "numeval",
    "body": [
      "num = #|${1:string}|"
    ],
    "description": "Safe string-to-number conversion"
  },
  "Scientific Format": {
    "prefix": "sci",
    "body": [
      "#^|${1:value}|"
    ],
    "description": "Scientific notation format"
  },
  "Comma Format": {
    "prefix": "comma",
    "body": [
      "#,|${1:value}|"
    ],
    "description": "Comma-separated format"
  },
  "Module Declaration": {
    "prefix": "module",
    "body": [
      "# ${1:module_name} {",
      "\t#> { ${2:exported_fn} }",
      "",
      "\t${2:exported_fn}(${3:params}) {",
      "\t\t<~ $0",
      "\t}",
      "}"
    ],
    "description": "Module block with export list"
  },
  "Comment": {
    "prefix": "//",
    "body": [
      "// ${1:comment}"
    ],
    "description": "Line comment"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": [
      "!? {",
      "\t${1:// code that may fail}",
      "} :! {",
      "\t>> \"error: \" _err ¶",
      "}"
    ],
    "description": "Try/catch block (!? :!) — _err holds the error"
  },
  "Try-Catch-Finally (typed)": {
    "prefix": "tryfull",
    "body": [
      "!? {",
      "\t${1:// code that may fail}",
      "} :! ##${2|IO,Div,Index,Type,Parse,Network,DB|} {",
      "\t${3:// typed handler}",
      "} :! {",
      "\t>> \"other: \" _err ¶",
      "} :> {",
      "\t${4:// finally — always runs}",
      "}"
    ],
    "description": "Try with typed catch, catch-all, and finally (:>)"
  },
  "Import std/math": {
    "prefix": "stdmath",
    "body": [
      "<# std/math => ${1:mat}"
    ],
    "description": "Import std/math (sqrt exp ln log pow sin cos … + PI/E)"
  },
  "Import std/random": {
    "prefix": "stdrandom",
    "body": [
      "<# std/random => ${1:rnd}"
    ],
    "description": "Import std/random (entero rango peso_f64)"
  },
  "Import std/json": {
    "prefix": "stdjson",
    "body": [
      "<# std/json => ${1:j}"
    ],
    "description": "Import std/json (decode encode)"
  },
  "Import std/io": {
    "prefix": "stdio",
    "body": [
      "<# std/io => ${1:io}"
    ],
    "description": "Import std/io (read write append exists delete list mkdir)"
  },
  "Import std/net": {
    "prefix": "stdnet",
    "body": [
      "<# std/net => ${1:net}"
    ],
    "description": "Import std/net (get post post_json head)"
  },
  "Import std/db": {
    "prefix": "stddb",
    "body": [
      "<# std/db => ${1:db}"
    ],
    "description": "Import std/db (ODBC: connect exec query tx …)"
  },
  "Read File (with error check)": {
    "prefix": "ioread",
    "body": [
      "${1:texto} = ${2:io}::read(${3:\"ruta.txt\"})",
      "? ${1:texto}$! {",
      "\t>> \"no se pudo leer\" ¶",
      "} _ {",
      "\t>> ${1:texto} ¶",
      "}"
    ],
    "description": "std/io read + soft-error check with $! (needs <# std/io => io)"
  },
  "Database Session (std/db)": {
    "prefix": "dbconnect",
    "body": [
      "${1:db}::connect(\"${2:c}\", \"${3:Driver={SQLite3};Database=/tmp/app.db;}\")",
      "${1:db}::exec(\"${2:c}\", \"${4:CREATE TABLE IF NOT EXISTS t(id INTEGER PRIMARY KEY)}\")",
      "${5:filas} = ${1:db}::query(\"${2:c}\", \"${6:SELECT * FROM t WHERE id = ?}\", (${7:1},))",
      "${1:db}::disconnect(\"${2:c}\")"
    ],
    "description": "std/db connect → exec → parameterized query → disconnect (needs <# std/db => db)"
  },
  "Typed Input": {
    "prefix": "intyped",
    "body": [
      "<< ${1|###,###(4),##.,##.(5\\,2),##\\\",##\\\"(20),##'|} \"${2:prompt}: \" ${3:var}"
    ],
    "description": "Typed/validated input — re-prompts until input matches the typespec"
  }
}
