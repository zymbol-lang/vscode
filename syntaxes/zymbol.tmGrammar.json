{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zymbol-Lang",
  "scopeName": "source.zymbol",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numeral-mode" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#numeric-casts" },
    { "include": "#error-types" },
    { "include": "#bash-exec" },
    { "include": "#script-exec" },
    { "include": "#control-flow" },
    { "include": "#error-handling" },
    { "include": "#io-operators" },
    { "include": "#function-operators" },
    { "include": "#compound-assign" },
    { "include": "#collection-operators" },
    { "include": "#module-operators" },
    { "include": "#data-operators" },
    { "include": "#format-expressions" },
    { "include": "#base-literals" },
    { "include": "#lifetime-end" },
    { "include": "#operators" },
    { "include": "#hot-identifiers" },
    { "include": "#function-calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.zymbol",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.zymbol" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.zymbol" }
          }
        },
        {
          "name": "comment.line.double-slash.zymbol",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zymbol",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zymbol",
              "match": "\\\\(n|t|\"|'|\\\\|\\{|\\}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "constant.other.placeholder.zymbol",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.zymbol",
          "match": "'([^'\\\\]|\\\\(n|t|\"|'|\\\\|u\\{[0-9A-Fa-f]+\\}))'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "ASCII scientific notation float",
          "name": "constant.numeric.scientific.zymbol",
          "match": "\\b[0-9]+\\.[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "comment": "ASCII float",
          "name": "constant.numeric.float.zymbol",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "comment": "ASCII scientific notation integer",
          "name": "constant.numeric.scientific.zymbol",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "comment": "ASCII integer",
          "name": "constant.numeric.integer.zymbol",
          "match": "\\b[0-9]+\\b"
        },
        {
          "comment": "Unicode float (any script: Devanagari, Arabic-Indic, Thai, etc.)",
          "name": "constant.numeric.float.zymbol",
          "match": "\\p{Nd}+\\.\\p{Nd}+"
        },
        {
          "comment": "Unicode integer (any script)",
          "name": "constant.numeric.integer.zymbol",
          "match": "\\p{Nd}+"
        }
      ]
    },
    "numeral-mode": {
      "patterns": [
        {
          "comment": "Mode-switch token: #d0d9# where d0/d9 are the 0 and 9 digits of any Unicode numeral block, including Klingon pIqaD PUA digits U+F8F0–U+F8F9 which have no \\p{Nd} category.",
          "name": "keyword.control.numeral-mode.zymbol",
          "match": "#(?:\\p{Nd}|[\\uF8F0-\\uF8F9])(?:\\p{Nd}|[\\uF8F0-\\uF8F9])#"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.zymbol",
          "match": "#[01]\\b"
        }
      ]
    },
    "numeric-casts": {
      "patterns": [
        {
          "comment": "Numeric cast operators — must precede error-types (## prefix)",
          "name": "keyword.operator.cast.zymbol",
          "match": "##\\.|###|##!"
        }
      ]
    },
    "error-types": {
      "patterns": [
        {
          "comment": "Error type specifiers in catch clauses: ##Div ##IO ##Index ##Type ##Parse ##Network ##_",
          "name": "support.type.zymbol",
          "match": "##[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "bash-exec": {
      "patterns": [
        {
          "comment": "Bash execution: <\\ cmd \\>  — delimiters yellow like {}, content orange like string",
          "name": "string.interpolated.shell.zymbol",
          "begin": "<\\\\",
          "end": "\\\\>",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.zymbol" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.zymbol" }
          },
          "patterns": [
            {
              "name": "variable.other.interpolated.zymbol",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
            }
          ]
        }
      ]
    },
    "script-exec": {
      "patterns": [
        {
          "comment": "Script execution: </ file.zy />  — delimiters yellow like {}, content orange like string",
          "name": "string.interpolated.script.zymbol",
          "begin": "</",
          "end": "/>",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.zymbol" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.zymbol" }
          }
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.zymbol",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.control.conditional.zymbol",
          "match": "_\\?"
        },
        {
          "name": "keyword.control.conditional.zymbol",
          "match": "(?<!\\w)\\?(?!\\?)"
        },
        {
          "name": "keyword.control.else.zymbol",
          "match": "(?<!_)_(?![\\?\\w])"
        },
        {
          "name": "keyword.control.loop.break.zymbol",
          "match": "@!"
        },
        {
          "name": "keyword.control.loop.continue.zymbol",
          "match": "@>"
        },
        {
          "name": "keyword.control.loop.sleep.zymbol",
          "match": "@~"
        },
        {
          "name": "keyword.control.loop.zymbol",
          "match": "@(?![!>~])"
        }
      ]
    },
    "error-handling": {
      "patterns": [
        {
          "name": "keyword.control.try.zymbol",
          "match": "!\\?"
        },
        {
          "name": "keyword.control.catch.zymbol",
          "match": ":!"
        },
        {
          "name": "keyword.control.finally.zymbol",
          "match": ":>"
        }
      ]
    },
    "io-operators": {
      "patterns": [
        {
          "name": "keyword.operator.output.clear.zymbol",
          "match": ">>!"
        },
        {
          "name": "keyword.operator.output.query.zymbol",
          "match": ">>\\?"
        },
        {
          "name": "keyword.operator.output.gate.zymbol",
          "match": ">>\\|"
        },
        {
          "name": "keyword.operator.output.pos.zymbol",
          "match": ">>~"
        },
        {
          "name": "keyword.operator.input.key.nonblock.zymbol",
          "match": "<<\\|\\?"
        },
        {
          "name": "keyword.operator.input.key.zymbol",
          "match": "<<\\|"
        },
        {
          "name": "keyword.operator.output.zymbol",
          "match": ">>"
        },
        {
          "name": "keyword.operator.input.zymbol",
          "match": "<<"
        },
        {
          "name": "keyword.operator.args.zymbol",
          "match": "><"
        },
        {
          "name": "keyword.operator.newline.zymbol",
          "match": "¶|\\\\\\\\(?!\\s)"
        }
      ]
    },
    "function-operators": {
      "patterns": [
        {
          "name": "keyword.operator.return-output.zymbol",
          "match": "<~"
        },
        {
          "name": "storage.type.function.arrow.zymbol",
          "match": "->"
        }
      ]
    },
    "compound-assign": {
      "patterns": [
        {
          "comment": "Constant declaration := — must precede plain =",
          "name": "keyword.operator.assignment.constant.zymbol",
          "match": ":="
        },
        {
          "comment": "Compound assignment operators — must precede plain = and single chars",
          "name": "keyword.operator.assignment.compound.zymbol",
          "match": "\\+=|-=|\\*=|/=|%=|\\^="
        },
        {
          "comment": "Increment / decrement — must precede + and -",
          "name": "keyword.operator.increment.zymbol",
          "match": "\\+\\+|--"
        }
      ]
    },
    "collection-operators": {
      "patterns": [
        {
          "comment": "Multi-char collection operators — must precede single-char patterns",
          "name": "keyword.operator.collection.zymbol",
          "match": "\\$(?:\\+\\+|\\+\\[|\\-\\[|--|\\?\\?|~~|/|<|!!)"
        },
        {
          "comment": "Single-char collection operators — $* is string repeat (GAP-001)",
          "name": "keyword.operator.collection.zymbol",
          "match": "\\$[#\\+\\-~\\?\\[<>|!/\\*]"
        }
      ]
    },
    "module-operators": {
      "patterns": [
        {
          "name": "keyword.control.import.zymbol",
          "match": "<#"
        },
        {
          "comment": "Export block — must precede module declaration to avoid # consuming #>",
          "name": "keyword.control.export.zymbol",
          "match": "#>"
        },
        {
          "name": "keyword.control.module.zymbol",
          "match": "^#(?!\\s*[01]\\b)(?!\\p{Nd}\\p{Nd}#)"
        },
        {
          "name": "keyword.operator.namespace.zymbol",
          "match": "::"
        }
      ]
    },
    "data-operators": {
      "patterns": [
        {
          "name": "keyword.operator.metadata.zymbol",
          "match": "#\\?"
        },
        {
          "name": "keyword.operator.numeric-eval.zymbol",
          "begin": "#\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "format-expressions": {
      "patterns": [
        {
          "name": "keyword.operator.format.scientific.zymbol",
          "begin": "#\\^(?:[.!][0-9]+)?\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.format.comma.zymbol",
          "begin": "#,(?:[.!][0-9]+)?\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "comment": "Precision round: #.N|expr|",
          "name": "keyword.operator.precision.round.zymbol",
          "begin": "#\\.[0-9]+\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "comment": "Precision truncate: #!N|expr|",
          "name": "keyword.operator.precision.trunc.zymbol",
          "begin": "#![0-9]+\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.base-conversion.binary.zymbol",
          "begin": "0b\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.base-conversion.octal.zymbol",
          "begin": "0o\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.base-conversion.decimal.zymbol",
          "begin": "0d\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.base-conversion.hex.zymbol",
          "begin": "0x\\|",
          "end": "\\|",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "base-literals": {
      "patterns": [
        {
          "name": "constant.numeric.base.binary.zymbol",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.base.octal.zymbol",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.base.decimal.zymbol",
          "match": "\\b0d[0-9]+\\b"
        },
        {
          "name": "constant.numeric.base.hexadecimal.zymbol",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        }
      ]
    },
    "lifetime-end": {
      "patterns": [
        {
          "comment": "Explicit lifetime end: \\ identifier — drops variable from scope",
          "name": "keyword.operator.lifetime-end.zymbol",
          "match": "\\\\(?!\\\\)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.zymbol",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.zymbol",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.zymbol",
          "match": "&&|\\|\\||!"
        },
        {
          "comment": "Comparison — <> is not-equal (Zymbol), != is NOT used",
          "name": "keyword.operator.comparison.zymbol",
          "match": "==|<>|<=|>=|<|>"
        },
        {
          "comment": "Arithmetic — ^ is exponentiation (Zymbol), ** is NOT used",
          "name": "keyword.operator.arithmetic.zymbol",
          "match": "\\^|\\+|\\-|\\*|\\/|%"
        },
        {
          "name": "keyword.operator.member-access.zymbol",
          "match": "\\."
        },
        {
          "name": "keyword.operator.assignment.zymbol",
          "match": "="
        },
        {
          "name": "punctuation.separator.comma.zymbol",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.zymbol",
          "match": ":"
        },
        {
          "comment": "Semicolon path separator inside index navigation [i>j ; k>l]",
          "name": "punctuation.separator.path.zymbol",
          "match": ";"
        }
      ]
    },
    "hot-identifiers": {
      "patterns": [
        {
          "comment": "Pre-hot function call: °name(...) — ° as hot marker, base name as function",
          "match": "(°)([^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.operator.hot-definition.zymbol" },
            "2": { "name": "entity.name.function.zymbol" }
          }
        },
        {
          "comment": "Pre-hot identifier: °name — ° as hot marker (anchors above nearest loop), base name as variable",
          "match": "(°)([^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°]*)",
          "captures": {
            "1": { "name": "keyword.operator.hot-definition.zymbol" },
            "2": { "name": "variable.other.zymbol" }
          }
        },
        {
          "comment": "Hot function call: name°(...) — base name highlighted as function, ° as hot marker",
          "match": "([^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°]*)(°)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.zymbol" },
            "2": { "name": "keyword.operator.hot-definition.zymbol" }
          }
        },
        {
          "comment": "Hot identifier: name° — base name as variable, ° as hot-definition marker",
          "match": "([^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\°]*)(°)",
          "captures": {
            "1": { "name": "variable.other.zymbol" },
            "2": { "name": "keyword.operator.hot-definition.zymbol" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Mirrors the Zymbol lexer: any char that is NOT whitespace, NOT a Unicode decimal digit (\\p{Nd}), and NOT one of the 25 operator chars is a valid identifier start. Continuation allows digits too. This naturally covers every script, emoji, Klingon pIqaD PUA, and any future fictional language without listing Unicode ranges.",
          "name": "entity.name.function.zymbol",
          "match": "[^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\]*(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Same exclusion logic as function-calls but without the lookahead. Covers all Unicode scripts, emoji, Klingon pIqaD, and fictional languages.",
          "name": "variable.other.zymbol",
          "match": "[^\\s\\p{Nd}\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\][^\\s\"'><!=+\\-*/%^&|?:.,;()\\[\\]{}@~#$¶\\\\]*"
        }
      ]
    }
  }
}
